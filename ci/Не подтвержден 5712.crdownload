@echo off
REM build_msi.bat - build MSI using WiX (assumes candle.exe and light.exe in PATH)
REM Usage: run from folder containing AsadbekTools.wxs and bundle\ folder
candle.exe AsadbekTools.wxs
if errorlevel 1 goto :err
light.exe -out AsadbekTools.msi AsadbekTools.wixobj
if errorlevel 1 goto :err
echo MSI built: AsadbekTools.msi
goto :eof
:err
echo Build failed. Ensure WiX is installed and candle/light are in PATH.
pause