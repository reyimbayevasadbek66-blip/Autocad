<!-- AsadbekTools.cui.xml (CUI snippet) -->
<Customizations>
  <Ribbon>
    <Tabs>
      <Tab Name="Asadbek Tools" ID="AsadbekToolsTab">
        <Panels>
          <Panel Name="Geodeziya" ID="GeodeziyaPanel">
            <Buttons>
              <Button Name="GG" ID="btnGG" CommandMacro="^C^C_GG" ToolTip="📍 GG" Image="Resources\\Icons\\GG.png" />
              <Button Name="Q" ID="btnQ" CommandMacro="^C^C_Q" ToolTip="🔴 Q" Image="Resources\\Icons\\Q.png" />
              <Button Name="DELINSIDE" ID="btnDelInside" CommandMacro="^C^C_DELINSIDE" ToolTip="✂ DELINSIDE" Image="Resources\\Icons\\DELINSIDE.png" />
              <Button Name="DELOUTSIDE" ID="btnDelOutside" CommandMacro="^C^C_DELOUTSIDE" ToolTip="⬜ DELOUTSIDE" Image="Resources\\Icons\\DELOUTSIDE.png" />
            </Buttons>
          </Panel>
        </Panels>
      </Tab>
    </Tabs>
  </Ribbon>
</Customizations>